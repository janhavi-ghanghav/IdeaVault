<file path="packages/types/index.ts">
export type Domain = 'DEV' | 'BUSINESS' | 'CREATIVE' | 'HEALTH' | 'TRAVEL' | 'LEARNING' | 'LIFE'
export type IdeaStatus = 'PENDING' | 'ENRICHED' | 'ACTIVE' | 'PARKED' | 'ARCHIVED'

export interface Enrichment{
    id: string;
    ideaId: string
    category: string
    summary: string
    viabilityNote: string
    phases: any[]
    estimatedHours?: number
    nextSteps: any[]
    domainMeta?: any
}

export interface Idea {
  id: string
  userId: string
  title: string
  rawDump: string
  domain: Domain
  status: IdeaStatus
  createdAt: string
  updatedAt: string
  enrichment: Enrichment | null
}

export const DOMAINS: Domain[] = ['DEV', 'BUSINESS', 'CREATIVE', 'HEALTH', 'TRAVEL', 'LEARNING', 'LIFE']

